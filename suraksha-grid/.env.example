# ─────────────────────────────────────────────────────────────────────────────
# Suraksha-Grid India – Environment Variables
# Copy this file to ".env" and fill in your actual credentials.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (with PostGIS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/surakshagrid

# Neo4j Aura Free Tier  →  https://console.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ML / Spatial tuning
HOTSPOT_RADIUS_METERS=500
MIN_CLUSTER_INCIDENTS=2

# Risk thresholds (0-100)
RISK_CRITICAL_THRESHOLD=75
RISK_HIGH_THRESHOLD=50
RISK_MODERATE_THRESHOLD=25
